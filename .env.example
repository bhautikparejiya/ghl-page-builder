# ── Public URL of this app (no trailing slash) ─────────────────────────────
# Local: http://localhost:3000   Production: https://your-app.vercel.app
APP_URL=http://localhost:3000

# ── HighLevel Marketplace app credentials (Developer portal → your app) ────
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
# Advanced Settings → Auth → "Shared Secret" (SSO key) used to decrypt user context
GHL_SSO_KEY=
# Optional: HighLevel webhook public key (PEM). When set, webhook signatures are verified.
GHL_WEBHOOK_PUBLIC_KEY=

# ── Security ───────────────────────────────────────────────────────────────
# Long random string used to sign editor sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# ── Storage (Upstash Redis via Vercel Marketplace) ─────────────────────────
# Required in production. Locally, leave empty to use a JSON file in ./.data
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Local testing only ─────────────────────────────────────────────────────
# Lets you open /app outside of HighLevel and log in with any location id.
# NEVER enable in production.
ALLOW_DEV_LOGIN=true
